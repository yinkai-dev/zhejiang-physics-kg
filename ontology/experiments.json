  { "id": "expskill.read.mm_ruler", "type": "ExpSkill", "category": "仪器读数", "title": "毫米刻度尺估读（精确到 0.1 mm）", "topics": ["力学", "光学"], "rule": "最小分度为 1 mm 时必须估读到下一位（以 cm 为单位小数点后保留两位，如 12.35 cm）。" },
  { "id": "expskill.read.vernier_caliper", "type": "ExpSkill", "category": "仪器读数", "title": "游标卡尺读数（10/20/50 分度不估读）", "topics": ["力学", "电学", "光学"], "rule": "读数 = 主尺整毫米数 + 对齐格数 × 精度（0.1 / 0.05 / 0.02 mm），严禁再往下估读位数，注意最终结果要求的单位是 mm 还是 cm。" },
  { "id": "expskill.read.micrometer", "type": "ExpSkill", "category": "仪器读数", "title": "螺旋测微器（千分尺）读数与半毫米线核对", "topics": ["电学", "光学"], "rule": "读数 = 固定刻度（看清 0.5 mm 半刻线是否露出！）+ 可动刻度估读值 × 0.01 mm，以 mm 为单位小数点后必有三位。" },
  { "id": "expskill.read.pointer_meters", "type": "ExpSkill", "category": "仪器读数", "title": "指针式电压表/电流表（1/2/5 分度）估读规则", "topics": ["电学"], "rule": "最小分度为 1（0.1V, 0.01A 等）估读到分度下一位；最小分度为 2 或 5（0.02A, 0.5V 等）估读到最小分度本位。" },
  { "id": "expskill.read.ohmmeter_scale", "type": "ExpSkill", "category": "仪器读数", "title": "多用电表欧姆挡选挡、欧姆调零与极性规则", "topics": ["电学"], "rule": "指针在中值电阻附近最准；偏角过大说明电阻小需换小倍率，换挡后必两表笔短接重新欧姆调零；电流红进黑出，黑表笔接表内电源正极。" },
  { "id": "expskill.read.stopwatch_spring", "type": "ExpSkill", "category": "仪器读数", "title": "机械秒表与弹簧测力计读数", "topics": ["力学"], "rule": "秒表不估读，小盘看半分钟过否决定大盘读 0~30s 还是 30~60s；弹簧秤使用前在施力方向调零。" },
  { "id": "expskill.op.ac_spark_timer", "type": "ExpSkill", "category": "实验操作", "title": "电磁打点计时器与电火花计时器操作规范", "topics": ["力学"], "rule": "电磁用约 8V 低压交流，电火花用 220V 交流；50Hz 下每打一点 0.02s，每 5 个点取一计数点 T=0.1s；必先接通电源稳定打点后再释放纸带。" },
  { "id": "expskill.op.friction_compensation", "type": "ExpSkill", "category": "实验操作", "title": "补偿打点纸带与导轨阻力（平衡摩擦力）", "topics": ["力学"], "rule": "垫高长木板无定滑轮一端，不挂槽码、连好纸带并开启计时器，轻推小车使纸带点迹间隔均匀；改变小车质量后无需重新补偿。" },
  { "id": "expskill.op.small_mass_approx", "type": "ExpSkill", "category": "实验操作", "title": "槽码小质量近似 (m ≪ M) 与力传感器免近似辨析", "topics": ["力学"], "rule": "用槽码重力 mg 近似绳拉力 T = \\frac{M}{M+m}mg 时要求 m \\ll M；若绳端直接串接力传感器或弹簧测力计读拉力，则无需满足 m \\ll M。" },
  { "id": "expskill.op.photogate_width_speed", "type": "ExpSkill", "category": "实验操作", "title": "光电门遮光条测瞬时速度与宽度误差", "topics": ["力学"], "rule": "用遮光条宽度 d 除以挡光时间 \\Delta t 近似中间时刻速度，加速经过光电门时中心位置速度略大于中间时刻速度 d/\\Delta t，遮光条越窄越准。" },
  { "id": "expskill.op.optical_coaxial_align", "type": "ExpSkill", "category": "实验操作", "title": "双缝干涉共轴调节与单缝双缝平行校准", "topics": ["光学"], "rule": "光源、滤光片、单缝、双缝中心共轴；若视场亮但无条纹或条纹模糊，多因单缝与双缝未调至相互平行。" },
  { "id": "expskill.op.smartphone_phyphox", "type": "ExpSkill", "category": "实验操作", "title": "智能手机内置传感器数字化创新实验迁移", "topics": ["力学", "电学"], "rule": "调用手机三轴加速度计测向心/竖直加速度、磁力计测磁感应强度、光传感器作光电门计时、麦克风测声波频率与多普勒频移。" },
  { "id": "expskill.circuit.ammeter_in_out", "type": "ExpSkill", "category": "电路设计", "title": "伏安法电流表内接与外接选型及试触判据", "topics": ["电学"], "rule": "R_x / R_A > R_V / R_x（大电阻）用内接法，R_{\\text{测}} = R_x + R_A > R_x；反之（小电阻）用外接法，R_{\\text{测}} < R_x。未知时看试触电压/电流相对变化幅度。" },
  { "id": "expskill.circuit.rheostat_div_limit", "type": "ExpSkill", "category": "电路设计", "title": "滑动变阻器分压式与限流式选型及实物连线", "topics": ["电学"], "rule": "要求电压从 0 连续调节、小阻值变阻器控大阻值负载、或限流会超量程时必选分压接法；闭合开关前滑片置于待测电路两端电压为 0 端。" },
  { "id": "expskill.circuit.meter_modification", "type": "ExpSkill", "category": "电路设计", "title": "电表扩程改装与已知内阻电表反串/反并用", "topics": ["电学"], "rule": "已知内阻 R_g 的电流表可直接当电压表读 U = I_g R_g；已知内阻的电压表可当电流表算 I = U / R_V，彻底消除分压或分流系统误差。" },
  { "id": "expskill.circuit.half_deflection", "type": "ExpSkill", "category": "电路设计", "title": "半偏法测电表内阻（限流恒流半偏 vs 分压恒压半偏）", "topics": ["电学"], "rule": "并联电阻箱测小内阻电流表（干路大电阻恒流）：R_{\\text{测}} < R_g；串联电阻箱测大内阻电压表（小阻分压恒压）：R_{\\text{测}} > R_V。" },
