  { "id": "expskill.data.error_algebraic_proof", "type": "ExpSkill", "category": "数据处理与误差", "title": "系统误差偏大/偏小/无影响的代数方程严格证明", "topics": ["力学", "电学", "热学", "光学"], "rule": "写出含未计入偏置量（如表内阻、摆球半径漏加、鲁尔死体积 V_0、重心偏移）的真实方程，若仅改变截距而不改变斜率，则由斜率所求物理量无系统误差。" }
