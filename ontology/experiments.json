  { "id": "expskill.circuit.emf_three_schemes", "type": "ExpSkill", "category": "电路设计", "title": "测电源 E, r 三大电路方案与系统误差对比", "topics": ["电学"], "rule": "伏安标准接法（相对电源外接，电压表分流）：E_{\\text{测}} < E,\\ r_{\\text{测}} < r；相对电源内接（电流表分压）：E_{\\text{测}} = E,\\ r_{\\text{测}} = r + R_A（干电池 r 小不宜直接用，可串定值保护电阻 R_0）。" },
  { "id": "expskill.circuit.fault_diagnosis", "type": "ExpSkill", "category": "电路设计", "title": "实验电路断路/短路故障定位（电压挡与欧姆挡）", "topics": ["电学"], "rule": "不断电用电压挡：某元件两端有接近电源电动势示数则该元件断路；断电拆除电源用欧姆挡测各段通断。" },
  { "id": "expskill.data.successive_diff", "type": "ExpSkill", "category": "数据处理与误差", "title": "纸带隔段逐差法求加速度", "topics": ["力学"], "rule": "6 段连续相等时间位移用 a = \\frac{(x_4+x_5+x_6)-(x_1+x_2+x_3)}{9T^2}（奇数段舍去中间或首段），避免只剩首尾两点的偶然误差。" },
  { "id": "expskill.data.projectile_grid_dt", "type": "ExpSkill", "category": "数据处理与误差", "title": "平抛频闪/方格非抛出点轨迹参数提取", "topics": ["力学"], "rule": "水平等间距 \\Delta x 意味着相邻点时间间隔相等 T：先由竖直 \\Delta y = y_2 - y_1 = gT^2 解出 T，再算 v_0 = \\Delta x / T 及中间点 v_{By} = (y_1+y_2)/(2T)（切忌把首点竖直速度当 0！）。" },
  { "id": "expskill.graph.vt_fit", "type": "ExpSkill", "category": "数据处理与误差", "title": "实验描点连线规范与斜率取远点计算", "topics": ["力学", "电学"], "rule": "用平滑直线或曲线拟合使点均匀分布在两侧，明显偏离的坏点舍弃；求直线斜率必须在直线上另取相距较远的两点计算，不可直接套原表格相邻实验点。" },
  { "id": "expskill.data.linearization_plot", "type": "ExpSkill", "category": "数据处理与误差", "title": "非线性物理关系“化曲为直”函数映射", "topics": ["力学", "电学", "热学", "光学"], "rule": "从物理定律推导出纵坐标 Y 关于横坐标 X 的严格线性方程 Y = kX + b，令斜率 k 和截距 b 与实验图线读数联立解出待测量。" },
