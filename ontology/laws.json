[
  { "id": "law.m1.point_mass_reference", "type": "ConceptAndLaw", "module": "M1 质点直线运动", "title": "质点理想模型与参考系", "topics": ["力学"], "unit": "unit.b1.c1.s1", "formulas": [], "conditions": ["物体形状大小对所研究问题影响可忽略时方可看作质点"], "requires_prereq": [] },
  { "id": "law.m1.displacement_distance", "type": "ConceptAndLaw", "module": "M1 质点直线运动", "title": "时刻时间间隔与位移路程", "topics": ["力学"], "unit": "unit.b1.c1.s2", "formulas": ["\\Delta x = x_2 - x_1"], "conditions": ["单向直线运动时位移大小等于路程，其余运动位移大小小于路程"], "requires_prereq": ["law.m1.point_mass_reference"] },
  { "id": "law.m1.avg_instant_velocity", "type": "ConceptAndLaw", "module": "M1 质点直线运动", "title": "平均速度、平均速率与瞬时速度", "topics": ["力学"], "unit": "unit.b1.c1.s3", "formulas": ["\\bar{v} = \\frac{\\Delta x}{\\Delta t}", "v_{\\text{率}} = \\frac{s}{\\Delta t}"], "conditions": ["平均速度为矢量（位移比时间），平均速率为标量（路程比时间）"], "requires_prereq": ["law.m1.displacement_distance"] },
  { "id": "law.m1.acceleration_concept", "type": "ConceptAndLaw", "module": "M1 质点直线运动", "title": "加速度定义与加减速判据", "topics": ["力学"], "unit": "unit.b1.c1.s5", "formulas": ["a = \\frac{\\Delta v}{\\Delta t}"], "conditions": ["a 与 v 同向则加速，反向则减速，与 a 本身增大或减小无关"], "requires_prereq": ["law.m1.avg_instant_velocity"] },
  { "id": "law.m1.uam_basic_kinematics", "type": "ConceptAndLaw", "module": "M1 质点直线运动", "title": "匀变速直线运动三大基本公式", "topics": ["力学"], "unit": "unit.b1.c2.s3", "formulas": ["v = v_0 + at", "x = v_0 t + \\frac{1}{2}at^2", "v^2 - v_0^2 = 2ax"], "conditions": ["仅适用于加速度 a 大小与方向恒定不变的直线运动；规定正方向后矢量带符号代入"], "requires_prereq": ["law.m1.acceleration_concept"] },
  { "id": "law.m1.uam_midtime_delta_x", "type": "ConceptAndLaw", "module": "M1 质点直线运动", "title": "匀变速中间时刻速度与邻差推论", "topics": ["力学"], "unit": "unit.b1.c2.s3", "formulas": ["v_{t/2} = \\bar{v} = \\frac{v_0 + v}{2}", "v_{x/2} = \\sqrt{\\frac{v_0^2 + v^2}{2}}", "\\Delta x = x_{n+1} - x_n = aT^2"], "conditions": ["仅限匀变速直线运动；恒有 v_{x/2} > v_{t/2}（匀速除外）"], "requires_prereq": ["law.m1.uam_basic_kinematics"] },
  { "id": "law.m1.uam_zero_init_ratios", "type": "ConceptAndLaw", "module": "M1 质点直线运动", "title": "初速为零匀加速比例推论", "topics": ["力学"], "unit": "unit.b1.c2.s3", "formulas": ["x_1 : x_2 : x_3 = 1 : 3 : 5", "t_1 : t_2 : t_3 = 1 : (\\sqrt{2}-1) : (\\sqrt{3}-\\sqrt{2})"], "conditions": ["初速度为 0 的匀加速直线运动，或末速度减为 0 的匀减速运动（逆向使用）"], "requires_prereq": ["law.m1.uam_basic_kinematics"] },
  { "id": "law.m1.free_fall_vertical_throw", "type": "ConceptAndLaw", "module": "M1 质点直线运动", "title": "自由落体与竖直上抛运动规律", "topics": ["力学"], "unit": "unit.b1.c2.s4", "formulas": ["v = gt,\\ h = \\frac{1}{2}gt^2", "y = v_0 t - \\frac{1}{2}gt^2"], "conditions": ["忽略空气阻力，只受重力；竖直上抛上升与下落对称"], "requires_prereq": ["law.m1.uam_basic_kinematics"] },

  { "id": "law.m2.gravity_center_of_mass", "type": "ConceptAndLaw", "module": "M2 相互作用与平衡", "title": "重力、重心与悬挂法", "topics": ["力学"], "unit": "unit.b1.c3.s1", "formulas": ["G = mg"], "conditions": ["竖直向下（非指向地心，两极赤道除外）；质量均匀规则物体重心在几何中心"], "requires_prereq": [] },
  { "id": "law.m2.elastic_force_hooke", "type": "ConceptAndLaw", "module": "M2 相互作用与平衡", "title": "形变、弹力方向与胡克定律", "topics": ["力学"], "unit": "unit.b1.c3.s1", "formulas": ["F = kx", "\\Delta F = k\\Delta x"], "conditions": ["胡克定律仅限弹簧在弹性限度内，x 为相对于原长的形变量；点面接触弹力垂直于面，轻杆弹力不一定沿杆"], "requires_prereq": [] },
  { "id": "law.m2.static_friction", "type": "ConceptAndLaw", "module": "M2 相互作用与平衡", "title": "静摩擦力有无、方向与被动特征", "topics": ["力学"], "unit": "unit.b1.c3.s2", "formulas": ["0 < f_s \\le f_{\\max}"], "conditions": ["两物体接触挤压、粗糙且有相对运动趋势但相对静止；大小由平衡条件或牛顿第二定律求解，不与正压力成正比"], "requires_prereq": ["law.m2.elastic_force_hooke"] },
  { "id": "law.m2.sliding_friction", "type": "ConceptAndLaw", "module": "M2 相互作用与平衡", "title": "滑动摩擦力公式与方向", "topics": ["力学"], "unit": "unit.b1.c3.s2", "formulas": ["f = \\mu F_N"], "conditions": ["接触面间已发生相对滑动；方向与相对接触面的运动方向相反（与对地速度方向可同可反可成夹角）"], "requires_prereq": ["law.m2.elastic_force_hooke"] },
  { "id": "law.m2.force_composition_decomp", "type": "ConceptAndLaw", "module": "M2 相互作用与平衡", "title": "力的平行四边形定则与正交分解", "topics": ["力学"], "unit": "unit.b1.c3.s4", "formulas": ["|F_1 - F_2| \\le F \\le F_1 + F_2", "F = \\sqrt{F_1^2 + F_2^2 + 2F_1 F_2\\cos\\theta}"], "conditions": ["一切矢量的合成与分解均遵循平行四边形定则（或三角形定则）"], "requires_prereq": [] },
  { "id": "law.m2.concurrent_equilibrium", "type": "ConceptAndLaw", "module": "M2 相互作用与平衡", "title": "共点力静态平衡条件", "topics": ["力学"], "unit": "unit.b1.c3.s5", "formulas": ["\\sum F_x = 0,\\quad \\sum F_y = 0"], "conditions": ["物体处于静止或匀速直线运动状态（加速度 a = 0）"], "requires_prereq": ["law.m2.force_composition_decomp"] },
  { "id": "law.m2.three_force_concurrency", "type": "ConceptAndLaw", "module": "M2 相互作用与平衡", "title": "三力平衡共面汇交原理", "topics": ["力学"], "unit": "unit.b1.c3.s5", "formulas": [], "conditions": ["刚体受三个不平行力处于平衡状态时，三力作用线必在同一平面内且相交于同一点"], "requires_prereq": ["law.m2.concurrent_equilibrium"] },
  { "id": "law.m2.newton_third_law", "type": "ConceptAndLaw", "module": "M2 相互作用与平衡", "title": "牛顿第三定律与平衡力辨析", "topics": ["力学"], "unit": "unit.b1.c3.s3", "formulas": ["\\mathbf{F}_{AB} = -\\mathbf{F}_{BA}"], "conditions": ["任意运动状态下普遍成立；作用力与反作用力同性质、异物体、不可合成抵消"], "requires_prereq": [] },

  { "id": "law.m3.newton_first_inertia", "type": "ConceptAndLaw", "module": "M3 牛顿运动定律", "title": "牛顿第一定律与惯性", "topics": ["力学"], "unit": "unit.b1.c4.s1", "formulas": [], "conditions": ["适用于惯性参考系；质量 m 是物体惯性大小的唯一量度"], "requires_prereq": [] },
  { "id": "law.m3.newton_second_law", "type": "ConceptAndLaw", "module": "M3 牛顿运动定律", "title": "牛顿第二定律（矢量性/瞬时性/独立性）", "topics": ["力学"], "unit": "unit.b1.c4.s3", "formulas": ["\\mathbf{F}_{\\text{合}} = m\\mathbf{a}", "F_x = ma_x,\\quad F_y = ma_y"], "conditions": ["宏观低速、惯性参考系（常取地面系）、国际单位制下比例系数 k=1；同体瞬时对应"], "requires_prereq": ["law.m1.acceleration_concept", "law.m2.force_composition_decomp"] },
  { "id": "law.m3.si_base_units", "type": "ConceptAndLaw", "module": "M3 牛顿运动定律", "title": "国际单位制（SI）七大基本量与基本单位", "topics": ["力学", "电学"], "unit": "unit.b1.c4.s4", "formulas": ["1\\,\\mathrm{N} = 1\\,\\mathrm{kg\\cdot m\\cdot s^{-2}}", "1\\,\\mathrm{J} = 1\\,\\mathrm{kg\\cdot m^2\\cdot s^{-2}}"], "conditions": ["七个基本量（长度 m、质量 kg、时间 s、电流 A、热力学温度 K、物质的量 mol、发光强度 cd），其余全为导出单位"], "requires_prereq": ["law.m3.newton_second_law"] },
  { "id": "law.m3.apparent_weight", "type": "ConceptAndLaw", "module": "M3 牛顿运动定律", "title": "超重、失重与完全失重判据", "topics": ["力学"], "unit": "unit.b1.c4.s6", "formulas": ["F_N = m(g + a_y)", "F_N = m(g - a_y)"], "conditions": ["实重 mg 不变；视重 F_N 大小仅取决于竖直加速度方向（向上超重、向下失重、a=g向下完全失重）"], "requires_prereq": ["law.m3.newton_second_law", "law.m2.newton_third_law"] },
  { "id": "law.m3.dynamics_two_problems", "type": "ConceptAndLaw", "module": "M3 牛顿运动定律", "title": "动力学两类基本问题", "topics": ["力学"], "unit": "unit.b1.c4.s5", "formulas": [], "conditions": ["已知受力求运动，或已知运动求受力，加速度 a 是核心桥梁"], "requires_prereq": ["law.m3.newton_second_law", "law.m1.uam_basic_kinematics"] },
  { "id": "law.m3.incline_accel_feature", "type": "ConceptAndLaw", "module": "M3 牛顿运动定律", "title": "斜面上滑与下滑动力学特征", "topics": ["力学"], "unit": "unit.b1.c4.s5", "formulas": ["a_{\\text{上}} = g\\sin\\theta + \\mu g\\cos\\theta", "a_{\\text{下}} = g\\sin\\theta - \\mu g\\cos\\theta"], "conditions": ["粗糙斜面上下滑摩擦方向相反导致加速度不同，不能全过程套同一匀变速公式；能重新下滑需满足 \\tan\\theta > \\mu"], "requires_prereq": ["law.m3.newton_second_law", "law.m2.sliding_friction"] },

  { "id": "law.m4.curvilinear_condition", "type": "ConceptAndLaw", "module": "M4 曲线与圆周运动", "title": "物体做曲线运动的条件与轨迹判据", "topics": ["力学"], "unit": "unit.b2.c5.s1", "formulas": [], "conditions": ["合外力方向与速度方向不在同一直线上；速度沿轨迹切线，合外力必指向轨迹凹侧"], "requires_prereq": ["law.m3.newton_second_law"] },
  { "id": "law.m4.motion_composition", "type": "ConceptAndLaw", "module": "M4 曲线与圆周运动", "title": "运动的合成与分解", "topics": ["力学"], "unit": "unit.b2.c5.s2", "formulas": ["\\mathbf{v} = \\mathbf{v}_x + \\mathbf{v}_y"], "conditions": ["分运动与合运动具有等时性、独立性与等效性"], "requires_prereq": ["law.m2.force_composition_decomp", "law.m4.curvilinear_condition"] },
  { "id": "law.m4.projectile_horizontal", "type": "ConceptAndLaw", "module": "M4 曲线与圆周运动", "title": "平抛运动规律与角度中点推论", "topics": ["力学"], "unit": "unit.b2.c5.s4", "formulas": ["x = v_0 t,\\quad y = \\frac{1}{2}gt^2", "\\tan\\theta = \\frac{v_y}{v_0} = 2\\tan\\alpha"], "conditions": ["水平初速度 v_0，只受重力（a=g 匀变速曲线运动）；速度反向延长线必过水平位移中点"], "requires_prereq": ["law.m4.motion_composition", "law.m1.free_fall_vertical_throw"] },
  { "id": "law.m4.oblique_projectile", "type": "ConceptAndLaw", "module": "M4 曲线与圆周运动", "title": "斜抛运动正交分解与对称性", "topics": ["力学"], "unit": "unit.b2.c5.s4", "formulas": ["v_{0x} = v_0\\cos\\theta,\\quad v_{0y} = v_0\\sin\\theta", "H = \\frac{v_0^2\\sin^2\\theta}{2g},\\quad X = \\frac{v_0^2\\sin 2\\theta}{g}"], "conditions": ["不计空气阻力时为匀变速曲线运动；最高点竖直分速度为 0 但水平速度 v_0\\cos\\theta 不为 0"], "requires_prereq": ["law.m4.projectile_horizontal"] },
  { "id": "law.m4.circular_kinematics", "type": "ConceptAndLaw", "module": "M4 曲线与圆周运动", "title": "圆周运动运动学参量与传动关系", "topics": ["力学"], "unit": "unit.b2.c6.s1", "formulas": ["v = \\omega r = \\frac{2\\pi r}{T} = 2\\pi f r = 2\\pi n r"], "conditions": ["共轴转动各点角速度 \\omega 相等；皮带/摩擦/齿轮不打滑传动边缘线速度大小 v 相等"], "requires_prereq": ["law.m4.curvilinear_condition"] },
  { "id": "law.m4.centripetal_force_accel", "type": "ConceptAndLaw", "module": "M4 曲线与圆周运动", "title": "向心加速度与向心力来源分析", "topics": ["力学"], "unit": "unit.b2.c6.s3", "formulas": ["a_n = \\frac{v^2}{r} = \\omega^2 r = \\frac{4\\pi^2}{T^2}r", "F_n = m a_n"], "conditions": ["匀速圆周运动合外力全部充当向心力；变速圆周运动仅沿半径指向圆心的法向分力充当向心力"], "requires_prereq": ["law.m4.circular_kinematics", "law.m3.newton_second_law"] },
  { "id": "law.m4.centrifugal_motion", "type": "ConceptAndLaw", "module": "M4 曲线与圆周运动", "title": "离心运动与近心运动供需判据", "topics": ["力学"], "unit": "unit.b2.c6.s4", "formulas": [], "conditions": ["径向指向圆心合力 F_{\\text{供}} < m v^2 / r 时做离心运动，F_{\\text{供}} = 0 时沿切线飞出"], "requires_prereq": ["law.m4.centripetal_force_accel"] },

  { "id": "law.m5.kepler_three_laws", "type": "ConceptAndLaw", "module": "M5 万有引力与航天", "title": "开普勒行星运动三大定律", "topics": ["力学"], "unit": "unit.b2.c7.s1", "formulas": ["\\frac{a^3}{T^2} = k", "v_{\\text{近}} r_{\\text{近}} = v_{\\text{远}} r_{\\text{远}}"], "conditions": ["同一中心天体的所有环绕天体共享同一常数 k；椭圆近远点连线垂直于速度时面积定律化为 v_1 r_1 = v_2 r_2"], "requires_prereq": ["law.m4.circular_kinematics"] },
  { "id": "law.m5.universal_gravitation", "type": "ConceptAndLaw", "module": "M5 万有引力与航天", "title": "万有引力定律", "topics": ["力学"], "unit": "unit.b2.c7.s2", "formulas": ["F = G\\frac{m_1 m_2}{r^2}"], "conditions": ["适用于两个质点，或质量分布均匀的球体（r 为球心距）"], "requires_prereq": ["law.m5.kepler_three_laws", "law.m4.centripetal_force_accel"] },
  { "id": "law.m5.gravity_gold_sub", "type": "ConceptAndLaw", "module": "M5 万有引力与航天", "title": "天体表面重力自转关系与黄金代换", "topics": ["力学"], "unit": "unit.b2.c7.s3", "formulas": ["GM = gR^2", "G\\frac{Mm}{R^2} - mg_{\\text{赤}} = m\\omega^2 R"], "conditions": ["忽略星球自转时表面万有引力等于重力 GM = gR^2；计入自转时两极 g 最大、赤道最小"], "requires_prereq": ["law.m5.universal_gravitation"] },
  { "id": "law.m5.celestial_mass_density", "type": "ConceptAndLaw", "module": "M5 万有引力与航天", "title": "中心天体质量与平均密度测定", "topics": ["力学"], "unit": "unit.b2.c7.s3", "formulas": ["M = \\frac{4\\pi^2 r^3}{GT^2}", "\\rho = \\frac{3\\pi r^3}{GT^2 R^3}"], "conditions": ["只能测定中心被环绕天体质量 M（环绕卫星质量 m 被约去）；当近地贴面飞行 r=R 时 \\rho = 3\\pi/(GT_0^2)"], "requires_prereq": ["law.m5.universal_gravitation"] },
  { "id": "law.m5.satellite_orbit_scaling", "type": "ConceptAndLaw", "module": "M5 万有引力与航天", "title": "圆轨道卫星参量随半径单调关系", "topics": ["力学"], "unit": "unit.b2.c7.s4", "formulas": ["v = \\sqrt{\\frac{GM}{r}},\\quad \\omega = \\sqrt{\\frac{GM}{r^3}},\\quad T = 2\\pi\\sqrt{\\frac{r^3}{GM}},\\quad a = \\frac{GM}{r^2}"], "conditions": ["仅由万有引力提供向心力的稳定圆轨道卫星（未点火状态）：高轨低速长周期小向心加速度"], "requires_prereq": ["law.m5.universal_gravitation"] },
  { "id": "law.m5.three_cosmic_velocities", "type": "ConceptAndLaw", "module": "M5 万有引力与航天", "title": "三大宇宙速度", "topics": ["力学"], "unit": "unit.b2.c7.s4", "formulas": ["v_1 = \\sqrt{\\frac{GM}{R}} = \\sqrt{gR} \\approx 7.9\\,\\mathrm{km/s}"], "conditions": ["第一宇宙速度是近地最大圆轨道环绕速度，也是从星球表面发射卫星的最小发射速度"], "requires_prereq": ["law.m5.satellite_orbit_scaling", "law.m5.gravity_gold_sub"] },
  { "id": "law.m5.geo_sync_satellite", "type": "ConceptAndLaw", "module": "M5 万有引力与航天", "title": "地球静止同步卫星定轨特征", "topics": ["力学"], "unit": "unit.b2.c7.s4", "formulas": [], "conditions": ["轨道平面必与赤道平面重合，周期等于地球自转周期，轨道高度固定"], "requires_prereq": ["law.m5.satellite_orbit_scaling"] },
  { "id": "law.m5.gravitational_pe_formula", "type": "ConceptAndLaw", "module": "M5 万有引力与航天", "title": "引力势能与天体轨道总机械能", "topics": ["力学"], "unit": "unit.b2.c8.s4", "formulas": ["E_p = -\\frac{GMm}{r}", "E = E_k + E_p = -\\frac{GMm}{2r}"], "conditions": ["取无穷远处引力势能为 0；轨道半径越大总机械能越大（负得越少）"], "requires_prereq": ["law.m5.satellite_orbit_scaling", "law.m6.mechanical_energy_cons"] },

  { "id": "law.m6.work_definition", "type": "ConceptAndLaw", "module": "M6 功、功率与机械能", "title": "恒力做功公式与相互作用力做功特点", "topics": ["力学"], "unit": "unit.b2.c8.s1", "formulas": ["W = Fl\\cos\\alpha"], "conditions": ["F 为恒力，l 为受力质点相对地面参考系的位移；一对静摩擦力总功恒为 0，一对滑动摩擦力总功恒为负"], "requires_prereq": ["law.m2.force_composition_decomp", "law.m1.displacement_distance"] },
  { "id": "law.m6.power_avg_instant", "type": "ConceptAndLaw", "module": "M6 功、功率与机械能", "title": "平均功率与瞬时功率", "topics": ["力学"], "unit": "unit.b2.c8.s1", "formulas": ["\\bar{P} = \\frac{W}{t} = F\\bar{v}\\cos\\alpha", "P = Fv\\cos\\alpha"], "conditions": ["计算瞬时功率必须取该时刻瞬时力与瞬时速度及二者夹角"], "requires_prereq": ["law.m6.work_definition"] },
  { "id": "law.m6.gravity_elastic_pe", "type": "ConceptAndLaw", "module": "M6 功、功率与机械能", "title": "重力势能、弹性势能与保守力做功关系", "topics": ["力学"], "unit": "unit.b2.c8.s2", "formulas": ["W_G = E_{p1} - E_{p2} = -\\Delta E_p", "E_{p\\text{弹}} = \\frac{1}{2}kx^2"], "conditions": ["重力与弹簧弹力做功与路径无关，只取决于始末位置（形变量）"], "requires_prereq": ["law.m6.work_definition", "law.m2.elastic_force_hooke"] },
  { "id": "law.m6.work_energy_theorem", "type": "ConceptAndLaw", "module": "M6 功、功率与机械能", "title": "动能与动能定理", "topics": ["力学"], "unit": "unit.b2.c8.s3", "formulas": ["E_k = \\frac{1}{2}mv^2", "W_{\\text{合}} = \\sum W_i = \\frac{1}{2}mv_2^2 - \\frac{1}{2}mv_1^2"], "conditions": ["惯性参考系下恒力/变力、直线/曲线、单阶段/多阶段全程普遍适用"], "requires_prereq": ["law.m6.work_definition", "law.m3.newton_second_law"] },
  { "id": "law.m6.mechanical_energy_cons", "type": "ConceptAndLaw", "module": "M6 功、功率与机械能", "title": "机械能守恒定律", "topics": ["力学"], "unit": "unit.b2.c8.s4", "formulas": ["E_{k1} + E_{p1} = E_{k2} + E_{p2}", "\\Delta E_k = -\\Delta E_p"], "conditions": ["系统内只有重力或弹簧弹力做功，其他外力与非保守内力不做功（或做功代数和时刻为 0）"], "requires_prereq": ["law.m6.work_energy_theorem", "law.m6.gravity_elastic_pe"] },
  { "id": "law.m6.multi_body_mech_energy", "type": "ConceptAndLaw", "module": "M6 功、功率与机械能", "title": "多物体系统机械能守恒（增减量法）", "topics": ["力学"], "unit": "unit.b2.c8.s4", "formulas": ["\\Delta E_{p\\text{减}} = \\Delta E_{k\\text{增}}"], "conditions": ["轻绳/轻杆/光滑接触连接的多物体系统无摩擦碰撞损耗时整体机械能守恒（无须选零势面）；注意各物体速率几何关系"], "requires_prereq": ["law.m6.mechanical_energy_cons"] },
  { "id": "law.m6.work_energy_relations", "type": "ConceptAndLaw", "module": "M6 功、功率与机械能", "title": "功能关系与摩擦生热定理", "topics": ["力学"], "unit": "unit.b2.c8.s4", "formulas": ["W_{\\text{除重弹}} = \\Delta E_{\\text{机}}", "Q = f_{\\text{滑}}\\cdot s_{\\text{相对路程}}"], "conditions": ["除重力和系统内弹簧弹力外其他力做功等于系统机械能变化量；一对滑动摩擦力总功转化为内能 Q"], "requires_prereq": ["law.m6.mechanical_energy_cons", "law.m2.sliding_friction"] },
  { "id": "law.m6.energy_conservation_macro", "type": "ConceptAndLaw", "module": "M6 功、功率与机械能", "title": "普遍能量守恒定律（力电热跨场总账）", "topics": ["力学", "电学", "热学"], "unit": "unit.b3.c12.s4", "formulas": ["\\sum E_{\\text{减}} = \\sum E_{\\text{增}}"], "conditions": ["孤立或封闭系统所有形式能量（动能、重力/弹性/电势能、电容储能、焦耳热、摩擦内能、辐射能）总和守恒"], "requires_prereq": ["law.m6.work_energy_relations"] },

  { "id": "law.m7.momentum_impulse", "type": "ConceptAndLaw", "module": "M7 动量与碰撞", "title": "动量、动量变化量与冲量", "topics": ["力学"], "unit": "unit.s1.c1.s1", "formulas": ["\\mathbf{p} = m\\mathbf{v},\\quad \\Delta\\mathbf{p} = \\mathbf{p}_2 - \\mathbf{p}_1", "\\mathbf{I} = \\mathbf{F}\\Delta t", "E_k = \\frac{p^2}{2m}"], "conditions": ["均为矢量；一维运算必须先选定正方向并带正负号"], "requires_prereq": ["law.m3.newton_second_law"] },
  { "id": "law.m7.momentum_theorem", "type": "ConceptAndLaw", "module": "M7 动量与碰撞", "title": "动量定理", "topics": ["力学"], "unit": "unit.s1.c1.s2", "formulas": ["\\mathbf{I}_{\\text{合}} = \\sum \\mathbf{F}_i \\Delta t_i = m\\mathbf{v}_2 - m\\mathbf{v}_1"], "conditions": ["惯性参考系下恒力与变力、单物与系统、直线与曲线（分量式）普遍成立；非瞬时过程切勿漏算重力冲量"], "requires_prereq": ["law.m7.momentum_impulse"] },
  { "id": "law.m7.momentum_conservation", "type": "ConceptAndLaw", "module": "M7 动量与碰撞", "title": "动量守恒定律（含单方向守恒）", "topics": ["力学"], "unit": "unit.s1.c1.s3", "formulas": ["m_1\\mathbf{v}_1 + m_2\\mathbf{v}_2 = m_1\\mathbf{v}_1' + m_2\\mathbf{v}_2'"], "conditions": ["①系统不受外力或合外力为 0；②内力远大于外力（极短碰撞爆炸）；③某一方向合外力为 0 则该方向分动量守恒；速度须相对同一惯性系"], "requires_prereq": ["law.m7.momentum_theorem", "law.m2.newton_third_law"] },
  { "id": "law.m7.elastic_collision_laws", "type": "ConceptAndLaw", "module": "M7 动量与碰撞", "title": "一维弹性碰撞双守恒与通解", "topics": ["力学"], "unit": "unit.s1.c1.s5", "formulas": ["v_1' = \\frac{(m_1-m_2)v_1 + 2m_2 v_2}{m_1+m_2}", "v_2' = \\frac{(m_2-m_1)v_2 + 2m_1 v_1}{m_1+m_2}", "v_1 - v_2 = v_2' - v_1'"], "conditions": ["系统动量守恒且机械能无损失；动碰静（v_2=0）时 m_1=m_2 交换速度"], "requires_prereq": ["law.m7.momentum_conservation", "law.m6.mechanical_energy_cons"] },
  { "id": "law.m7.inelastic_collision_bounds", "type": "ConceptAndLaw", "module": "M7 动量与碰撞", "title": "完全非弹性碰撞与碰撞物理可行性三判据", "topics": ["力学"], "unit": "unit.s1.c1.s5", "formulas": ["(m_1+m_2)v_{\\text{共}} = m_1 v_1 + m_2 v_2", "\\Delta E_{k\\max} = \\frac{1}{2}\\frac{m_1 m_2}{m_1+m_2}(v_1-v_2)^2"], "conditions": ["共速（或粘合/弹簧最短最长/滑块在板上相对静止瞬间）动能损失最大；真实碰撞须满足：动量守恒、总动能不增、碰后位置速度合理不穿模"], "requires_prereq": ["law.m7.momentum_conservation", "law.m6.work_energy_relations"] },
  { "id": "law.m7.recoil_avg_momentum", "type": "ConceptAndLaw", "module": "M7 动量与碰撞", "title": "反冲与人船模型平均动量守恒", "topics": ["力学"], "unit": "unit.s1.c1.s6", "formulas": ["m_1 x_1 = m_2 x_2,\\quad x_1 + x_2 = L"], "conditions": ["系统初始静止且在某方向动量守恒，任意过程对地分位移大小与质量成反比"], "requires_prereq": ["law.m7.momentum_conservation"] },
  { "id": "law.m7.rocket_variable_mass", "type": "ConceptAndLaw", "module": "M7 动量与碰撞", "title": "火箭喷气反冲原理", "topics": ["力学"], "unit": "unit.s1.c1.s6", "formulas": ["(M - \\Delta m)\\Delta v - \\Delta m\\,u = 0"], "conditions": ["喷气瞬间忽略外力冲量，注意燃气速度相对地面与相对箭体的参考系转换"], "requires_prereq": ["law.m7.momentum_conservation"] },

  { "id": "law.m8.shm_kinematics_dynamics", "type": "ConceptAndLaw", "module": "M8 机械振动与机械波", "title": "简谐运动动力学判据与振动方程", "topics": ["力学"], "unit": "unit.s1.c2.s2", "formulas": ["F_{\\text{回}} = -kx", "x(t) = A\\sin\\left(\\frac{2\\pi}{T}t + \\varphi_0\\right)"], "conditions": ["x 为相对平衡位置的位移；平衡位置处回复力为 0（合外力未必为 0）"], "requires_prereq": ["law.m3.newton_second_law", "law.m2.elastic_force_hooke"] },
  { "id": "law.m8.shm_symmetry_energy", "type": "ConceptAndLaw", "module": "M8 机械振动与机械波", "title": "简谐运动对称性与振动能量守恒", "topics": ["力学"], "unit": "unit.s1.c2.s3", "formulas": ["E = E_k + E_p = \\frac{1}{2}kA^2"], "conditions": ["关于平衡位置对称的两点位移、回复力、加速度等大反向，速率相等，往返时间对称"], "requires_prereq": ["law.m8.shm_kinematics_dynamics", "law.m6.mechanical_energy_cons"] },
  { "id": "law.m8.simple_pendulum", "type": "ConceptAndLaw", "module": "M8 机械振动与机械波", "title": "单摆简谐条件与周期公式", "topics": ["力学"], "unit": "unit.s1.c2.s4", "formulas": ["T = 2\\pi\\sqrt{\\frac{l}{g}}"], "conditions": ["最大摆角 \\theta < 5^\\circ；l 为悬点到摆球质心的等效摆长，g 为当地等效重力加速度"], "requires_prereq": ["law.m8.shm_kinematics_dynamics", "law.m4.centripetal_force_accel"] },
  { "id": "law.m8.forced_vib_resonance", "type": "ConceptAndLaw", "module": "M8 机械振动与机械波", "title": "阻尼振动、受迫振动与共振", "topics": ["力学"], "unit": "unit.s1.c2.s6", "formulas": ["f_{\\text{受迫}} = f_{\\text{驱动}}", "f_{\\text{驱动}} = f_{\\text{固有}} \\Rightarrow A_{\\max}"], "conditions": ["受迫振动稳定后频率严格等于驱动力频率；驱动力频率越接近固有频率振幅越大"], "requires_prereq": ["law.m8.shm_kinematics_dynamics"] },
  { "id": "law.m8.wave_formation_params", "type": "ConceptAndLaw", "module": "M8 机械振动与机械波", "title": "机械波的形成、横纵波与波速波长频率关系", "topics": ["力学"], "unit": "unit.s1.c3.s2", "formulas": ["v = \\lambda f = \\frac{\\lambda}{T}"], "conditions": ["需波源和弹性介质（真空不传机械波）；波速由介质决定，频率由波源决定；各质点起振方向与波源起振方向相同且不随波迁移"], "requires_prereq": ["law.m8.shm_kinematics_dynamics"] },
  { "id": "law.m8.wave_diffraction", "type": "ConceptAndLaw", "module": "M8 机械振动与机械波", "title": "波的反射、折射与明显衍射条件", "topics": ["力学"], "unit": "unit.s1.c3.s3", "formulas": [], "conditions": ["障碍物或缝孔尺寸比波长小或与波长相差不多时发生明显衍射"], "requires_prereq": ["law.m8.wave_formation_params"] },
  { "id": "law.m8.wave_superposition_interf", "type": "ConceptAndLaw", "module": "M8 机械振动与机械波", "title": "波的叠加原理与稳定干涉加强减弱判据", "topics": ["力学"], "unit": "unit.s1.c3.s4", "formulas": ["\\Delta r = |r_1 - r_2| = k\\lambda", "\\Delta r = (2k+1)\\frac{\\lambda}{2}"], "conditions": ["两列同类波频率相同、相位差恒定、振动方向相同；同相波源波程差为半波长偶数倍加强（A=A_1+A_2）、奇数倍减弱（A=|A_1-A_2|），反相波源反之"], "requires_prereq": ["law.m8.wave_formation_params"] },
  { "id": "law.m8.doppler_effect", "type": "ConceptAndLaw", "module": "M8 机械振动与机械波", "title": "多普勒效应", "topics": ["力学"], "unit": "unit.s1.c3.s5", "formulas": [], "conditions": ["波源真实频率不变；观察者与波源相互靠近时接收频率高于波源频率，相互远离时低于波源频率"], "requires_prereq": ["law.m8.wave_formation_params"] },

  { "id": "law.e1.charge_conservation", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "元电荷、起电方式与电荷守恒定律", "topics": ["电学"], "unit": "unit.b3.c9.s1", "formulas": ["e = 1.60\\times 10^{-19}\\,\\mathrm{C}"], "conditions": ["任何带电体电荷量均为 e 整数倍；两个完全相同导体球接触后总电荷代数和均分"], "requires_prereq": [] },
  { "id": "law.e1.coulomb_law", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "库仑定律", "topics": ["电学"], "unit": "unit.b3.c9.s2", "formulas": ["F = k\\frac{|q_1 q_2|}{r^2}"], "conditions": ["真空中静止点电荷；近距离金属球需计及同种电荷排斥外移（F 偏小）或异种吸引内移（F 偏大）"], "requires_prereq": ["law.e1.charge_conservation"] },
  { "id": "law.e1.electric_field_superpos", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "电场强度、点电荷场强与电场叠加", "topics": ["电学"], "unit": "unit.b3.c9.s3", "formulas": ["\\mathbf{E} = \\frac{\\mathbf{F}}{q}", "E = k\\frac{Q}{r^2}"], "conditions": ["场强遵循矢量平行四边形叠加；正电荷受力同 E 向，负电荷受力反 E 向"], "requires_prereq": ["law.e1.coulomb_law", "law.m2.force_composition_decomp"] },
  { "id": "law.e1.electrostatic_shielding", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "静电平衡导体与静电屏蔽", "topics": ["电学"], "unit": "unit.b3.c9.s4", "formulas": ["E_{\\text{内}} = 0,\\quad \\mathbf{E}_{\\text{外}} + \\mathbf{E}_{\\text{感}} = 0"], "conditions": ["处于静电平衡的导体内部合场强处处为 0，整个导体是等势体，表面场强垂直于表面"], "requires_prereq": ["law.e1.electric_field_superpos"] },
  { "id": "law.e1.electric_pe_work", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "静电力做功与电势能变化", "topics": ["电学"], "unit": "unit.b3.c10.s1", "formulas": ["W_{AB} = E_{pA} - E_{pB} = -\\Delta E_p", "E_p = q\\varphi"], "conditions": ["静电力做功与路径无关；正电荷在电势高处电势能大，负电荷在电势高处电势能小（带符号代算）"], "requires_prereq": ["law.e1.electric_field_superpos", "law.m6.work_definition"] },
  { "id": "law.e1.potential_equipotential", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "电势、电势差与等势面性质", "topics": ["电学"], "unit": "unit.b3.c10.s2", "formulas": ["\\varphi_A = \\frac{E_{pA}}{q}", "U_{AB} = \\frac{W_{AB}}{q} = \\varphi_A - \\varphi_B = -U_{BA}"], "conditions": ["沿电场线方向电势必定降低最快；电场线处处垂直于等势面，等差等势面越密处场强越大"], "requires_prereq": ["law.e1.electric_pe_work"] },
  { "id": "law.e1.uniform_field_u_ed", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "匀强电场电势差与场强关系", "topics": ["电学"], "unit": "unit.b3.c10.s3", "formulas": ["U = Ed"], "conditions": ["仅定量适用于匀强电场，d 为两点沿电场线方向的距离投影；匀强场中平行等长线段电势差必相等"], "requires_prereq": ["law.e1.potential_equipotential"] },
  { "id": "law.e1.capacitor_formulas", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "电容器电容定义式与平行板决定式", "topics": ["电学"], "unit": "unit.b3.c10.s4", "formulas": ["C = \\frac{Q}{U} = \\frac{\\Delta Q}{\\Delta U}", "C = \\frac{\\varepsilon_r S}{4\\pi kd}"], "conditions": ["Q 为单个极板所带电荷量绝对值"], "requires_prereq": ["law.e1.uniform_field_u_ed"] },
  { "id": "law.e1.charged_particle_accel", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "带电粒子在电场中的加速", "topics": ["电学", "力学"], "unit": "unit.b3.c10.s5", "formulas": ["qU = \\frac{1}{2}mv^2 - \\frac{1}{2}mv_0^2"], "conditions": ["不计重力（或计入重力功）时对匀强与非匀强静电场普遍适用"], "requires_prereq": ["law.e1.potential_equipotential", "law.m6.work_energy_theorem"] },
  { "id": "law.e1.charged_particle_deflect", "type": "ConceptAndLaw", "module": "E1 静电场力与能", "title": "带电粒子在匀强电场中的类平抛偏转", "topics": ["电学", "力学"], "unit": "unit.b3.c10.s5", "formulas": ["t = \\frac{l}{v_0},\\quad a = \\frac{qU}{md}", "y = \\frac{qUl^2}{2mdv_0^2},\\quad \\tan\\theta = \\frac{qUl}{mdv_0^2}"], "conditions": ["粒子垂直射入平行板匀强电场且能穿出极板（y \\le d/2）；速度反向延长线交水平位移中点"], "requires_prereq": ["law.e1.uniform_field_u_ed", "law.m4.projectile_horizontal"] },

  { "id": "law.e2.current_micro_macro", "type": "ConceptAndLaw", "module": "E2 恒定电流与电路", "title": "电流定义式与微观表达式", "topics": ["电学"], "unit": "unit.b3.c11.s1", "formulas": ["I = \\frac{q}{t}", "I = nqSv"], "conditions": ["电解液双向导电时 q = |q_+| + |q_-|；微观式中 n 为单位体积自由电荷数，v 为定向漂移速率"], "requires_prereq": ["law.e1.charge_conservation"] },
  { "id": "law.e2.ohm_volt_ampere_curve", "type": "ConceptAndLaw", "module": "E2 恒定电流与电路", "title": "部分电路欧姆定律与伏安特性曲线", "topics": ["电学"], "unit": "unit.b3.c11.s2", "formulas": ["I = \\frac{U}{R}"], "conditions": ["适用于金属与电解质溶液等纯电阻导体（气态与半导体二极管不适用）；I-U 曲线上点与原点连线斜率为 1/R"], "requires_prereq": ["law.e2.current_micro_macro"] },
  { "id": "law.e2.resistance_law", "type": "ConceptAndLaw", "module": "E2 恒定电流与电路", "title": "电阻定律与电阻率", "topics": ["电学"], "unit": "unit.b3.c11.s2", "formulas": ["R = \\rho\\frac{l}{S}"], "conditions": ["均匀导体；等体积拉伸为 n 倍长时横截面积变为 S/n，电阻变为 n^2 R"], "requires_prereq": ["law.e2.ohm_volt_ampere_curve"] },
  { "id": "law.e2.series_parallel_meters", "type": "ConceptAndLaw", "module": "E2 恒定电流与电路", "title": "串并联电路性质与电表改装", "topics": ["电学"], "unit": "unit.b3.c11.s4", "formulas": ["R_{\\text{串}} = \\sum R_i,\\quad \\frac{1}{R_{\\text{并}}} = \\sum \\frac{1}{R_i}", "R_V = (n-1)R_g,\\quad R_A = \\frac{R_g}{n-1}"], "conditions": ["串联正比分压，并联反比分流"], "requires_prereq": ["law.e2.ohm_volt_ampere_curve"] },
  { "id": "law.e2.electric_work_joule", "type": "ConceptAndLaw", "module": "E2 恒定电流与电路", "title": "电功、电功率与焦耳定律", "topics": ["电学"], "unit": "unit.b3.c12.s1", "formulas": ["W = UIt,\\quad P = UI", "Q = I^2 R t,\\quad P_{\\text{热}} = I^2 R"], "conditions": ["纯电阻电路 W = Q = UIt = I^2Rt = \\frac{U^2}{R}t；含电动机/充电电池非纯电阻电路 W = Q + E_{\\text{其他}}，严禁套 I=U/R"], "requires_prereq": ["law.e2.series_parallel_meters"] },
